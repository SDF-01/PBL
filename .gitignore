*.py[cod]

# E2E run artifacts. Regenerated by every `run_e2e.py` / portal run: the
# videos plus the run_*.json reports (which inline every step screenshot as
# base64) were adding tens of MB per run to git history.
# custom_tests.json is the exception - it holds portal-authored test case
# definitions, which are source, not output.
tests/e2e/reports/*
!tests/e2e/reports/custom_tests.json
